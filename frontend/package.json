  "private": true,
  "type": "module",
  "description": "Protótipo CurtailLess v5 para decisões de exposição, manutenção e bateria.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "vite preview --outDir build/client --host 127.0.0.1 --port 4173",
